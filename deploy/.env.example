# Copy to deploy/.env (umask 077; cp .env.example .env), fill in, then: docker compose up -d
# Generate the secrets with:  openssl rand -base64 32   (keys)   and   openssl rand -hex 16   (password)
# Back the filled-in file up offline: without ENCRYPTION_KEY and ENCRYPTION_KEY_FACTOR the data cannot be read.

# Root key material. Written into OpenBAO on the first start; later only OpenBAO needs it (forget-env-keys.sh).
ENCRYPTION_KEY=
ENCRYPTION_KEY_FACTOR=
DB_PASSWORD=

# The exact address users open (else the WebSocket is rejected and messages only appear after a refresh).
SITE_URL=http://localhost:8065

# Server image: built locally on the first `up` by default. To use the image built on GitHub instead:
#   SMM_IMAGE=ghcr.io/ghiyastfarisi/smm:v1.0.0-rc.5   then   docker compose pull server && docker compose up -d
SMM_IMAGE=mrpostman-server:local

# Release profile (locked settings, TLS edge on :8443 with deploy/tls/{cert,key}.pem from gen-cert.sh):
# COMPOSE_FILE=docker-compose.yml:docker-compose.release.yml
